NODE_ENV=production
# Set STAGING_MODE=true only on a separate staging domain with sandbox credentials.
STAGING_MODE=false
STAGING_REGISTRATIONS_ENABLED=false
PUBLIC_APP_URL=https://YOUR_DOMAIN
CORS_ORIGIN=https://YOUR_DOMAIN
DATABASE_URL=postgresql://gbz:CHOOSE_STRONG_PASSWORD@db:5432/gold_body_zone?schema=public
DIRECT_URL=postgresql://gbz:CHOOSE_STRONG_PASSWORD@db:5432/gold_body_zone?schema=public
POSTGRES_USER=gbz
POSTGRES_PASSWORD=CHOOSE_STRONG_PASSWORD
POSTGRES_DB=gold_body_zone
CHECKOUT_TOKEN_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
AADHAAR_ENCRYPTION_KEY=REPLACE_WITH_SEPARATE_32_CHARACTER_SECRET
CASHFREE_APP_ID=YOUR_APP_ID
CASHFREE_SECRET_KEY=YOUR_SECRET_KEY
CASHFREE_ENV=production
