generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}

enum GenderEligibility {
  ALL
  MALE_ONLY
  FEMALE_ONLY
}

enum CategoryGender {
  MALE
  FEMALE
  OPEN
}

enum CategoryType {
  WEIGHT
  HEIGHT
  OPEN
}

enum ParticipantGender {
  MALE
  FEMALE
  OTHER
}

enum RepresentingType {
  GYM
  INDIVIDUAL
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum RefundStatus {
  REQUESTED
  PENDING
  SUCCESS
  FAILED
}

model AdminProfile {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String?   @map("password_hash")
  passwordChangedAt DateTime? @map("password_changed_at")
  resetTokenHash    String?   @map("reset_token_hash")
  resetExpiresAt    DateTime? @map("reset_expires_at")
  fullName          String?   @map("full_name")
  avatarUrl         String?   @map("avatar_url")
  avatarStoragePath String?   @map("avatar_storage_path")
  role              AdminRole @default(ADMIN)
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  sessions          AdminSession[]
  requestedRefunds  Refund[]

  @@map("admin_profiles")
}

model AdminSession {
  id         String       @id @default(uuid())
  adminId    String       @map("admin_id")
  tokenHash  String       @unique @map("token_hash")
  expiresAt  DateTime     @map("expires_at")
  createdAt  DateTime     @default(now()) @map("created_at")
  admin      AdminProfile @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model Competition {
  id                   String                @id @default(uuid())
  slug                 String                @unique
  name                 String
  competitionType      String                @map("competition_type")
  description          String?
  posterUrl            String?               @map("poster_url")
  posterStoragePath    String?               @map("poster_storage_path")
  eventDate            DateTime?             @map("event_date")
  registrationDeadline DateTime?             @map("registration_deadline")
  venue                String?
  registrationFee      Decimal?              @db.Decimal(10, 2) @map("registration_fee")
  maxParticipants      Int?                  @map("max_participants")
  genderEligibility    GenderEligibility     @default(ALL) @map("gender_eligibility")
  ageEligibility       String?               @map("age_eligibility")
  isPublished          Boolean               @default(false) @map("is_published")
  publishedAt          DateTime?             @map("published_at")
  isCompleted          Boolean               @default(false) @map("is_completed")
  completedAt          DateTime?             @map("completed_at")
  isRegistrationClosed Boolean               @default(false) @map("is_registration_closed")
  registrationClosedAt DateTime?             @map("registration_closed_at")
  trunkNumbersAssignedAt DateTime?             @map("trunk_numbers_assigned_at")
  isDefault            Boolean               @default(false) @map("is_default")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  categories           CompetitionCategory[]
  registrations        Registration[]
  photos               CompetitionPhoto[]
  judgingSessions      JudgingSession[]
  judges               Judge[]
  assignedJudges       CompetitionJudge[]
  liveHeats            LiveHeat[]
  liveState            LiveCompetitionState?

  @@index([isPublished, eventDate])
  @@map("competitions")
}

model CompetitionCategory {
  id            String          @id @default(uuid())
  competitionId String          @map("competition_id")
  categoryType  CategoryType    @default(OPEN) @map("category_type")
  gender        CategoryGender  @default(OPEN)
  name          String
  ruleNote      String?         @map("rule_note")
  sortOrder     Int             @default(0) @map("sort_order")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  competition   Competition     @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  groups        CategoryGroup[]
  registrations Registration[]

  @@index([competitionId, sortOrder])
  @@map("competition_categories")
}

model CategoryGroup {
  id            String              @id @default(uuid())
  categoryId    String              @map("category_id")
  name          String
  sortOrder     Int                 @default(0) @map("sort_order")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  category      CompetitionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  registrations Registration[]

  @@index([categoryId, sortOrder])
  @@map("category_groups")
}

model Registration {
  id                 String              @id @default(uuid())
  registrationCode   String              @unique @map("registration_code")
  competitionId      String              @map("competition_id")
  categoryId         String              @map("category_id")
  groupId            String?             @map("group_id")
  groupName          String?             @map("group_name")
  participantName    String              @map("participant_name")
  email              String
  mobileNumber       String              @map("mobile_number")
  gender             ParticipantGender
  age                Int
  heightCm           Decimal?            @db.Decimal(5, 2) @map("height_cm")
  weightKg           Decimal?            @db.Decimal(5, 2) @map("weight_kg")
  district           String
  representingType   RepresentingType    @default(GYM) @map("representing_type")
  gymName            String              @map("gym_name")
  aadhaarEncrypted   String?             @map("aadhaar_encrypted")
  aadhaarHash        String?             @map("aadhaar_hash")
  aadhaarLast4       String?             @map("aadhaar_last4")
  aadhaarConsentAt   DateTime?           @map("aadhaar_consent_at")
  registrationStatus RegistrationStatus  @default(PENDING) @map("registration_status")
  paymentStatus      PaymentStatus       @default(PENDING) @map("payment_status")
  trunkNumber        Int?                @map("trunk_number")
  isManual           Boolean             @default(false) @map("is_manual")
  paymentMethod      String?             @map("payment_method")
  acknowledgementEmailSentAt DateTime?   @map("acknowledgement_email_sent_at")
  confirmationEmailSentAt    DateTime?   @map("confirmation_email_sent_at")
  verifiedAt         DateTime?           @map("verified_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  competition        Competition         @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  category           CompetitionCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  group              CategoryGroup?      @relation(fields: [groupId], references: [id], onDelete: SetNull)
  payment            Payment?
  judgeSelections    JudgeSemifinalistSelection[]
  judgeRankings      JudgeRanking[]

  @@unique([competitionId, email])
  @@unique([competitionId, trunkNumber])
  @@index([competitionId, createdAt])
  @@index([competitionId, trunkNumber])
  @@index([categoryId])
  @@index([groupId])
  @@index([registrationStatus])
  @@index([paymentStatus])
  @@map("registrations")
}

model Payment {
  id                 String        @id @default(uuid())
  registrationId     String        @unique @map("registration_id")
  cashfreeOrderId    String?       @unique @map("cashfree_order_id")
  cashfreePaymentId  String?       @unique @map("cashfree_payment_id")
  amount             Decimal?      @db.Decimal(10, 2)
  currency           String        @default("INR")
  status             PaymentStatus @default(PENDING)
  paidAt             DateTime?     @map("paid_at")
  verifiedAt         DateTime?     @map("verified_at")
  verificationSource String?       @map("verification_source")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  registration       Registration  @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  refunds            Refund[]

  @@index([status])
  @@map("payments")
}

model Refund {
  id                 String       @id @default(uuid())
  paymentId          String       @map("payment_id")
  cashfreeRefundId   String       @unique @map("cashfree_refund_id")
  providerRefundId   String?      @unique @map("provider_refund_id")
  amount             Decimal      @db.Decimal(10, 2)
  status             RefundStatus @default(REQUESTED)
  note               String?
  requestedByAdminId String?      @map("requested_by_admin_id")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  processedAt        DateTime?    @map("processed_at")
  payment            Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  requestedByAdmin   AdminProfile? @relation(fields: [requestedByAdminId], references: [id], onDelete: SetNull)

  @@index([paymentId, status])
  @@map("refunds")
}

model CompetitionPhoto {
  id               String      @id @default(uuid())
  competitionId    String      @map("competition_id")
  photoUrl         String      @map("photo_url")
  photoStoragePath String      @map("photo_storage_path")
  caption          String?
  sortOrder        Int         @default(0) @map("sort_order")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  competition      Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@index([competitionId, sortOrder])
  @@map("competition_photos")
}

model Judge {
  id             String   @id @default(uuid())
  competitionId  String?  @map("competition_id")
  name           String
  email          String?
  phone          String?
  city           String?
  designation    String?  @default("Judge")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  competition    Competition?                 @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  assignments    CompetitionJudge[]
  selections     JudgeSemifinalistSelection[]
  rankings       JudgeRanking[]
  submissions    JudgeCategorySubmission[]
  liveSubmissions LiveHeatSubmission[]

  @@index([competitionId])
  @@map("judges")
}

model CompetitionJudge {
  id            String      @id @default(uuid())
  competitionId String      @map("competition_id")
  judgeId       String      @map("judge_id")
  accessToken   String?     @unique @map("access_token")
  createdAt     DateTime    @default(now()) @map("created_at")

  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  judge         Judge       @relation(fields: [judgeId], references: [id], onDelete: Cascade)

  @@unique([competitionId, judgeId])
  @@index([competitionId])
  @@index([judgeId])
  @@map("competition_judges")
}

model JudgingSession {
  id            String    @id @default(uuid())
  competitionId String    @map("competition_id")
  token         String    @unique
  status        String    @default("ACTIVE")
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  selections    JudgeSemifinalistSelection[]
  rankings      JudgeRanking[]
  submissions   JudgeCategorySubmission[]

  @@index([token])
  @@index([competitionId])
  @@map("judging_sessions")
}

model JudgeSemifinalistSelection {
  id             String         @id @default(uuid())
  sessionId      String         @map("session_id")
  judgeId        String         @map("judge_id")
  registrationId String         @map("registration_id")
  categoryId     String         @map("category_id")
  groupId        String?        @map("group_id")
  groupKey       String         @default("DEFAULT") @map("group_key")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  session        JudgingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  judge          Judge          @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  registration   Registration   @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([sessionId, judgeId, registrationId])
  @@index([sessionId, judgeId, categoryId, groupKey])
  @@map("judge_semifinalist_selections")
}

model JudgeRanking {
  id             String         @id @default(uuid())
  sessionId      String         @map("session_id")
  judgeId        String         @map("judge_id")
  registrationId String         @map("registration_id")
  categoryId     String         @map("category_id")
  groupId        String?        @map("group_id")
  groupKey       String         @default("DEFAULT") @map("group_key")
  rank           Int
  title          String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  session        JudgingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  judge          Judge          @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  registration   Registration   @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([sessionId, judgeId, registrationId])
  @@unique([sessionId, judgeId, categoryId, groupKey, rank])
  @@index([sessionId, judgeId, categoryId, groupKey])
  @@map("judge_rankings")
}

model JudgeCategorySubmission {
  id          String         @id @default(uuid())
  sessionId   String         @map("session_id")
  judgeId     String         @map("judge_id")
  categoryId  String         @map("category_id")
  groupKey    String         @default("DEFAULT") @map("group_key")
  submittedAt DateTime       @default(now()) @map("submitted_at")

  session     JudgingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  judge       Judge          @relation(fields: [judgeId], references: [id], onDelete: Cascade)

  @@unique([sessionId, judgeId, categoryId, groupKey])
  @@index([sessionId, judgeId, categoryId])
  @@map("judge_category_submissions")
}

// ---------------------------------------------------------------------------
// Live round-based scoring (Form 1 voting, Form 2 ranking, Form 3 titles)
// ---------------------------------------------------------------------------

model LiveHeat {
  id             String      @id @default(uuid())
  competitionId  String      @map("competition_id")
  round          Int
  categoryId     String?     @map("category_id")
  groupId        String?     @map("group_id")
  parentHeatId   String?     @map("parent_heat_id")
  isTiebreak     Boolean     @default(false) @map("is_tiebreak")
  status         String      @default("OPEN")
  label          String?
  selectionLimit Int?        @map("selection_limit")
  participantIds Json        @default("[]") @map("participant_ids")
  titles         Json        @default("[]")
  openedAt       DateTime    @default(now()) @map("opened_at")
  closedAt       DateTime?   @map("closed_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  competition    Competition          @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  submissions    LiveHeatSubmission[]

  @@index([competitionId, round])
  @@index([competitionId, status])
  @@map("live_heats")
}

model LiveHeatSubmission {
  id          String   @id @default(uuid())
  heatId      String   @map("heat_id")
  judgeId     String   @map("judge_id")
  payload     Json     @default("{}")
  submittedAt DateTime @default(now()) @map("submitted_at")

  heat        LiveHeat @relation(fields: [heatId], references: [id], onDelete: Cascade)
  judge       Judge    @relation(fields: [judgeId], references: [id], onDelete: Cascade)

  @@unique([heatId, judgeId])
  @@index([heatId])
  @@map("live_heat_submissions")
}

model LiveCompetitionState {
  id               String      @id @default(uuid())
  competitionId    String      @unique @map("competition_id")
  round1Qualifiers Json        @default("{}") @map("round1_qualifiers")
  round1Advancements Json      @default("{}") @map("round1_advancements")
  titleAwards      Json        @default("[]") @map("title_awards")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  competition      Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@map("live_competition_states")
}
