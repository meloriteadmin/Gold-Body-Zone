# Server Configuration
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Supabase PostgreSQL (Prisma)
# DATABASE_URL: Transaction/Connection Pooler URL (port 6543 with ?pgbouncer=true)
# DIRECT_URL: Direct connection URL for Prisma migrations (port 5432)
DATABASE_URL=
DIRECT_URL=

# Supabase Server Configuration (NEVER expose service role key to frontend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
